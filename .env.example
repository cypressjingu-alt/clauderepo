# Copy to .env on each machine. Relative paths resolve against the repo folder.

# Full paths to ffmpeg and ffprobe (the gyan.dev "essentials" build has every filter used here)
FFMPEG=C:\Users\<you>\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE=C:\Users\<you>\tools\ffmpeg\bin\ffprobe.exe

# The analysis venv's python: python -m venv .venv, then .venv\Scripts\pip install -r analysis\requirements.txt
PYTHON=.venv\Scripts\python.exe

# Pool root (the ambient-pool Syncthing share once it exists)
AMBIENT_POOL=C:\Users\<you>\ambient-pool

# SQLite DB, caches and renders. Never put this in a synced folder.
AMBIENT_DATA=data

# Wait while Roblox (RobloxPlayerBeta.exe) runs before rendering or analyzing. Keep "on" on the laptop;
# "off" is fine on the desktop, which has RAM to spare.
AMBIENT_ROBLOX_GATE=on
